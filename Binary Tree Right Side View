class Solution {
public:
    vector<int> rightSideView(TreeNode* root) {
     vector<int>ans;
        if(root==NULL)
        {
            return ans;
        }
        queue<TreeNode*>q;
        q.push(root);
        while(!q.empty())
        {
            vector<int>v;
            int size=q.size();
            while(size--)
            {
                TreeNode*temp=q.front();
                q.pop();
                v.push_back(temp->val);
                if(temp->left!=NULL)
                {
                    q.push(temp->left);
                }
                if(temp->right!=NULL)
                {
                    q.push(temp->right);
                }
            }
            ans.push_back(v[v.size()-1]);
        }
        return ans;
    }
};


